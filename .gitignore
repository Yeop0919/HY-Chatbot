# 로그 파일 무시
*.log

# 파이썬 관련 캐시 파일
__pycache__/
*.py[cod]
*$py.class

# VSCode 설정 파일
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# 가상환경 폴더
venv/
.venv/
env/
ENV/

# 환경변수 (실제 값은 .env.example만 커밋)
.env
!.env.example

# 모델이나 대형 바이너리 파일
*.pt
*.h5
*.pkl
*.zip

# 빌드/캐시
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
*.egg-info/

# OS 별 불필요한 파일
.DS_Store
Thumbs.db

# IDE
.idea/
