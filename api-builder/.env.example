# 이 파일을 복사해서 .env로 저장한 뒤 실제 값을 채워 넣으세요.
# .env는 git에 커밋되지 않습니다 (.gitignore 참고).

# Environment: local, staging, production
ENVIRONMENT=local

PORT=8000
SERVICE_NAME="공지 챗봇 API"
SERVICE_CODE=notice-chatbot
MAJOR_VERSION=v1
STATUS=dev

# Request Server URL
SERVER_URL=""

# LOG
LEVEL=DEBUG
JSON_LOG=False

# LOG SAVE CONFIG
SAVE=True
LOG_SAVE_PATH="./logs"
ROTATION=00:00
RETENTION="10 days"
COMPRESSION=zip

# Backend
BACKEND_CORS_ORIGINS="http://localhost,https://localhost"

# API 인증에 쓰이는 토큰 (프론트/클라이언트가 Authorization 헤더로 보내야 하는 값)
ELASTIC_API_KEY=""

# 로컬 Elasticsearch (docker-compose로 띄울 경우 기본값 그대로 사용 가능)
# ELASTIC_CLOUD_URL / ELASTIC_CLOUD_ID / ELASTIC_USERNAME / ELASTIC_PASSWORD 는
# 클라우드 Elastic을 쓸 때만 필요합니다.
ELASTIC_CLOUD_URL=""
ELASTIC_CLOUD_ID=""
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=""

# OpenAI (임베딩 + GPT-4o 답변 생성에 사용)
OPENAI_API_KEY=""

# Zilliz / Milvus 클라우드 벡터 DB
MILVUS_URI=""
MILVUS_TOKEN=""

# /rest/upload, /rest/emb 가 공지 원본을 임시로 저장/처리하는 경로
NOTICE_DB_PATH=./data/notice_db
